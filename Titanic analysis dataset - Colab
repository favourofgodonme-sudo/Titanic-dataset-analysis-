.string-repr button.copy { background: transparent; border-width: medium; border-style: none; border-color: currentcolor; border-image: none; margin-left: 4px; opacity: 0; padding: 0px; stroke: var(--colab-primary-text-color); transition: opacity 0.2s; }

.string-repr button.copy svg { width: 14px; }

.string-repr.hover button.copy, .string-repr:hover button.copy { opacity: 1; }

