input.raw_input { font-family: var(--colab-code-font-family); width: 90%; }

input { background: var(--colab-primary-surface-color); border: 1px solid var(--colab-bold-border-color); color: var(--colab-primary-text-color); }

#output-area { display: flow-root; }

#output-area button.colab { background-color: var(--colab-secondary-surface-color); border: 0px; box-shadow: rgba(0, 0, 0, 0.15) 0px 1px 3px 1px, rgba(0, 0, 0, 0.3) 0px 1px 2px 0px; color: var(--colab-primary-text-color); font-family: var(--colab-chrome-font-family); font-size: 11px; margin: 0px 4px 10px; padding: 6px; text-transform: uppercase; user-select: none; }

